<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Antenne" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:colorBackground">#0B0C12</item>
        <item name="android:colorAccent">#5AC8FA</item>
        <item name="android:colorPrimary">#0B0C12</item>
        <item name="android:colorPrimaryDark">#0B0C12</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:alertDialogTheme">@style/Theme.Antenne.Dialog</item>
    </style>

    <style name="Theme.Antenne.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#5AC8FA</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>
</resources>
